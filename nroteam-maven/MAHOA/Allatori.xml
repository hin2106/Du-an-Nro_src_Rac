<config>
    <input basedir="../target">
        <jar in="nro-server-1.0.0.jar" out="nro-server-1.0.0-obf.jar"/>
    </input>

    <keep-names>
        <class template="class server.ServerManager">
            <method template="public static void main(java.lang.String[])"/>
        </class>

        <class template="class event.*"/>

        <class template="class player.IDMark" ignore="true">
            <method template="java.lang.String getTagNameShop()"/>
        </class>

        <class template="class managers.boss.*EventManager" ignore="true">
            <method template="static * gI()"/>
            <method template="* removeAllByBossId(int)"/>
        </class>
    </keep-names>

    <ignore-classes>
        <class template="class ch.qos.*"/>
        <class template="class com.formdev.*"/>
        <class template="class com.google.*"/>
        <class template="class com.googlecode.*"/>
        <class template="class com.mysql.*"/>
        <class template="class com.zaxxer.*"/>
        <class template="class io.netty.*"/>
        <class template="class lombok.*"/>
        <class template="class net.miginfocom.*"/>
        <class template="class org.apache.*"/>
        <class template="class org.json.*"/>
        <class template="class org.pcap4j.*"/>
        <class template="class org.slf4j.*"/>
    </ignore-classes>

    <property name="log-file" value="../target/allatori-log.xml"/>
    <property name="string-encryption" value="maximum"/>
    <property name="string-encryption-type" value="strong"/>
    <property name="string-encryption-version" value="v4"/>
    <property name="control-flow-obfuscation" value="enable"/>
    <property name="extensive-flow-obfuscation" value="normal"/>
    <property name="default-package" value="a"/>
    <property name="packages-naming" value="abc"/>
    <property name="classes-naming" value="compact"/>
    <property name="methods-naming" value="keywords"/>
    <property name="fields-naming" value="keywords"/>
    <property name="local-variables-naming" value="single-name"/>
    <property name="update-resource-names" value="enable"/>
    <property name="update-resource-contents" value="enable:UTF-8"/>
    <property name="line-numbers" value="remove"/>
    <property name="generics" value="remove"/>
    <property name="inner-classes" value="remove"/>
    <property name="throws-clause" value="remove"/>
    <property name="member-reorder" value="random"/>
    <property name="synthetize-methods" value="all"/>
    <property name="synthetize-fields" value="all"/>
    <property name="output-jar-compression-level" value="9"/>
</config>